    CheckL "Length('dbcdc', 'cdd') Distance", Length_Distance("dbcdc", "cdd", True), 2
    CheckL "Length('dbcdc', 'cdd') Similarity", Length_Similarity("dbcdc", "cdd", True), 3
    CheckD "Length('dbcdc', 'cdd') NormalizedDistance", Length_NormalizedDistance("dbcdc", "cdd", True), 0.4
    CheckD "Length('dbcdc', 'cdd') NormalizedSimilarity", Length_NormalizedSimilarity("dbcdc", "cdd", True), 0.6
    CheckL "Length('acb', 'acdd') Distance", Length_Distance("acb", "acdd", True), 1
    CheckL "Length('acb', 'acdd') Similarity", Length_Similarity("acb", "acdd", True), 3
    CheckD "Length('acb', 'acdd') NormalizedDistance", Length_NormalizedDistance("acb", "acdd", True), 0.25
    CheckD "Length('acb', 'acdd') NormalizedSimilarity", Length_NormalizedSimilarity("acb", "acdd", True), 0.75
    CheckL "Length('Hello', 'hello', CaseSensitive=False) Distance", Length_Distance("Hello", "hello", False), 0
    CheckL "Length('TeSt', 'tEXT', CaseSensitive=False) Distance", Length_Distance("TeSt", "tEXT", False), 0
    CheckL "Length('ABC', 'abcd', CaseSensitive=False) Distance", Length_Distance("ABC", "abcd", False), 1
    CheckL "Length('MARTHA', 'marhta', CaseSensitive=False) Distance", Length_Distance("MARTHA", "marhta", False), 0
    CheckL "Length('Kitten', 'SITTING', CaseSensitive=False) Distance", Length_Distance("Kitten", "SITTING", False), 1
    CheckD "Length_Maximum", Length_Maximum("test", "testing"), 7
End Sub

Private Sub CheckL(ByVal Name As String, ByVal Actual As Long, ByVal Expected As Long)
    If Actual = Expected Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub

Private Sub CheckS(ByVal Name As String, ByVal Actual As String, ByVal Expected As String)
    If StrComp(Actual, Expected, vbBinaryCompare) = 0 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got """ & Actual & """, expected """ & Expected & """"
    End If
End Sub

Private Sub CheckD(ByVal Name As String, ByVal Actual As Double, ByVal Expected As Double)
    If Abs(Actual - Expected) < 0.000000001 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub
