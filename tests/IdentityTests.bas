    CheckD "Identity('acddcc', 'cdb') NormalizedSimilarity", Identity_NormalizedSimilarity("acddcc", "cdb", True), 0
    CheckL "Identity('Hello', 'hello', CaseSensitive=False) Distance", Identity_Distance("Hello", "hello", False), 0
    CheckL "Identity('TeSt', 'tEXT', CaseSensitive=False) Distance", Identity_Distance("TeSt", "tEXT", False), 1
    CheckL "Identity('ABC', 'abcd', CaseSensitive=False) Distance", Identity_Distance("ABC", "abcd", False), 1
    CheckL "Identity('MARTHA', 'marhta', CaseSensitive=False) Distance", Identity_Distance("MARTHA", "marhta", False), 1
    CheckL "Identity('Kitten', 'SITTING', CaseSensitive=False) Distance", Identity_Distance("Kitten", "SITTING", False), 1
    CheckD "Identity_Maximum", Identity_Maximum("test", "testing"), 1
End Sub

Private Sub CheckL(ByVal Name As String, ByVal Actual As Long, ByVal Expected As Long)
    If Actual = Expected Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub

Private Sub CheckS(ByVal Name As String, ByVal Actual As String, ByVal Expected As String)
    If StrComp(Actual, Expected, vbBinaryCompare) = 0 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got """ & Actual & """, expected """ & Expected & """"
    End If
End Sub

Private Sub CheckD(ByVal Name As String, ByVal Actual As Double, ByVal Expected As Double)
    If Abs(Actual - Expected) < 0.000000001 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub
