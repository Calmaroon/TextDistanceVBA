Private Function DnaTable() As Variant
    Dim t() As Variant
    ReDim t(1 To 10, 1 To 3)
    t(1, 1) = "A": t(1, 2) = "A": t(1, 3) = 10
    t(2, 1) = "G": t(2, 2) = "G": t(2, 3) = 7
    t(3, 1) = "C": t(3, 2) = "C": t(3, 3) = 9
    t(4, 1) = "T": t(4, 2) = "T": t(4, 3) = 8
    t(5, 1) = "A": t(5, 2) = "G": t(5, 3) = -1
    t(6, 1) = "A": t(6, 2) = "C": t(6, 3) = -3
    t(7, 1) = "A": t(7, 2) = "T": t(7, 3) = -4
    t(8, 1) = "G": t(8, 2) = "C": t(8, 3) = -5
    t(9, 1) = "G": t(9, 2) = "T": t(9, 3) = -3
    t(10, 1) = "C": t(10, 2) = "T": t(10, 3) = 0
    DnaTable = t
End Function

Private Function DupTable() As Variant
    Dim t() As Variant
    ReDim t(1 To 12, 1 To 3)
    t(1, 1) = "A": t(1, 2) = "A": t(1, 3) = 10
    t(2, 1) = "G": t(2, 2) = "G": t(2, 3) = 7
    t(3, 1) = "C": t(3, 2) = "C": t(3, 3) = 9
    t(4, 1) = "T": t(4, 2) = "T": t(4, 3) = 8
    t(5, 1) = "A": t(5, 2) = "G": t(5, 3) = -1
    t(6, 1) = "A": t(6, 2) = "C": t(6, 3) = -3
    t(7, 1) = "A": t(7, 2) = "T": t(7, 3) = -4
    t(8, 1) = "G": t(8, 2) = "C": t(8, 3) = -5
    t(9, 1) = "G": t(9, 2) = "T": t(9, 3) = -3
    t(10, 1) = "C": t(10, 2) = "T": t(10, 3) = 0
    t(11, 1) = "A": t(11, 2) = "G": t(11, 3) = 99
    t(12, 1) = "a": t(12, 2) = "c": t(12, 3) = 42
    DupTable = t
End Function

Private Sub CheckL(ByVal Name As String, ByVal Actual As Long, ByVal Expected As Long)
    If Actual = Expected Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub

Private Sub CheckS(ByVal Name As String, ByVal Actual As String, ByVal Expected As String)
    If StrComp(Actual, Expected, vbBinaryCompare) = 0 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got """ & Actual & """, expected """ & Expected & """"
    End If
End Sub

Private Sub CheckD(ByVal Name As String, ByVal Actual As Double, ByVal Expected As Double)
    If Abs(Actual - Expected) < 0.000000001 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub
