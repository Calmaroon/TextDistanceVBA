    CheckD "MLIPNS('one two two three', 'two two two', 2, 0.25, 2) NormalizedSimilarity", MLIPNS_NormalizedSimilarity("one two two three", "two two two", True, 2, 0.25, 2), 0
    CheckL "MLIPNS('Hello', 'hello', CaseSensitive=False) Distance", MLIPNS_Distance("Hello", "hello", False, 1, 0.25, 2), 0
    CheckL "MLIPNS('TeSt', 'tEXT', CaseSensitive=False) Distance", MLIPNS_Distance("TeSt", "tEXT", False, 1, 0.25, 2), 0
    CheckL "MLIPNS('ABC', 'abcd', CaseSensitive=False) Distance", MLIPNS_Distance("ABC", "abcd", False, 1, 0.25, 2), 0
    CheckL "MLIPNS('MARTHA', 'marhta', CaseSensitive=False) Distance", MLIPNS_Distance("MARTHA", "marhta", False, 1, 0.25, 2), 0
    CheckL "MLIPNS('Kitten', 'SITTING', CaseSensitive=False) Distance", MLIPNS_Distance("Kitten", "SITTING", False, 1, 0.25, 2), 0
    CheckD "MLIPNS_Maximum", MLIPNS_Maximum("test", "testing"), 1
End Sub

Private Sub CheckL(ByVal Name As String, ByVal Actual As Long, ByVal Expected As Long)
    If Actual = Expected Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub

Private Sub CheckS(ByVal Name As String, ByVal Actual As String, ByVal Expected As String)
    If StrComp(Actual, Expected, vbBinaryCompare) = 0 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got """ & Actual & """, expected """ & Expected & """"
    End If
End Sub

Private Sub CheckD(ByVal Name As String, ByVal Actual As Double, ByVal Expected As Double)
    If Abs(Actual - Expected) < 0.000000001 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub
