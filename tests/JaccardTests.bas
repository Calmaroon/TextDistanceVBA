    CheckD "Jaccard('TeSt', 'tEXT', CaseSensitive=False) Distance", Jaccard_Distance("TeSt", "tEXT", False, 1, False), 0.4
    CheckD "Jaccard('ABC', 'abcd', CaseSensitive=False) Distance", Jaccard_Distance("ABC", "abcd", False, 1, False), 0.25
    CheckD "Jaccard('MARTHA', 'marhta', CaseSensitive=False) Distance", Jaccard_Distance("MARTHA", "marhta", False, 1, False), 0
    CheckD "Jaccard('Kitten', 'SITTING', CaseSensitive=False) Distance", Jaccard_Distance("Kitten", "SITTING", False, 1, False), 0.5555555555555556
    CheckD "Jaccard_Maximum", Jaccard_Maximum("test", "testing"), 1
End Sub

Private Sub CheckL(ByVal Name As String, ByVal Actual As Long, ByVal Expected As Long)
    If Actual = Expected Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub

Private Sub CheckS(ByVal Name As String, ByVal Actual As String, ByVal Expected As String)
    If StrComp(Actual, Expected, vbBinaryCompare) = 0 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got """ & Actual & """, expected """ & Expected & """"
    End If
End Sub

Private Sub CheckD(ByVal Name As String, ByVal Actual As Double, ByVal Expected As Double)
    If Abs(Actual - Expected) < 0.000000001 Then
        mPass = mPass + 1
    Else
        mFail = mFail + 1
        Debug.Print "FAIL " & Name & ": got " & Actual & ", expected " & Expected
    End If
End Sub
